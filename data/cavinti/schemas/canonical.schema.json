{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bettercavinti.local/schemas/canonical.schema.json",
  "title": "Reviewed civic data pack and evidence contracts",
  "$defs": {
    "text": {"type":"string","minLength":1},
    "url": {"type":"string","format":"uri","pattern":"^https?://"},
    "date": {"type":"string","format":"capture-date"},
    "hash": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "source-check": {"type":"object","required":["sourceId","retrievedAt","availabilityStatus","freshnessStatus","note"],"properties":{"sourceId":{"$ref":"#/$defs/text"},"retrievedAt":{"$ref":"#/$defs/date"},"note":{"$ref":"#/$defs/text"},"availabilityStatus":{"enum":["available","access-blocked","not-published","empty-in-capture","not-found-in-checked-source","unknown"]},"freshnessStatus":{"enum":["current-at-capture","stale","not-checked","not-applicable"]}}},
    "research-updates": {"type":"object","required":["schemaVersion","capturedAt","scope","observations"],"properties":{"schemaVersion":{"const":"civic-research-updates/v1"},"capturedAt":{"$ref":"#/$defs/date"},"scope":{"$ref":"#/$defs/text"},"observations":{"type":"array","items":{"type":"object","required":["recordId","sourceId","sourceUrl","retrievedAt","availabilityStatus","verificationStatus","freshnessStatus","notes"],"properties":{"recordId":{"$ref":"#/$defs/text"},"sourceId":{"$ref":"#/$defs/text"},"sourceUrl":{"$ref":"#/$defs/url"},"retrievedAt":{"$ref":"#/$defs/date"},"notes":{"$ref":"#/$defs/text"},"availabilityStatus":{"enum":["available","access-blocked","not-published","empty-in-capture","not-found-in-checked-source","unknown"]},"verificationStatus":{"enum":["primary-direct","primary-index-only","secondary-only","machine-extracted-unreviewed","conflicted","not-reviewed"]},"freshnessStatus":{"enum":["current-at-capture","stale","not-checked","not-applicable"]}}}}}},
    "source": {"type":"object","required":["id","name","tier","url","formats","retrievalStatus","coverage"],"properties":{"id":{"$ref":"#/$defs/text"},"name":{"$ref":"#/$defs/text"},"tier":{"enum":["primary-lgu","primary-lgu-social","primary-government","primary-government-platform","secondary-reference","secondary-aggregator","regional-directory-lead","community-directory","community-guidance","project-documentation"]},"url":{"$ref":"#/$defs/url"},"dataUrl":{"$ref":"#/$defs/url"},"adapter":{"enum":["municipal-legislation-datatables/v1"]},"formats":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"}},"retrievalStatus":{"$ref":"#/$defs/text"},"coverage":{"$ref":"#/$defs/text"},"lastCheckedAt":{"$ref":"#/$defs/date"},"sourceContentHash":{"$ref":"#/$defs/hash"}},"dependencies":{"adapter":["dataUrl"]}},
    "source-register": {"type":"object","required":["schemaVersion","capturedAt","sources","refreshMode"],"properties":{"schemaVersion":{"const":"civic-source-register/v1"},"capturedAt":{"$ref":"#/$defs/date"},"refreshMode":{"const":"manual-on-demand"},"sources":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/source"}}}},
    "statistic": {"type":"object","required":["indicator","value","unit","geography","sourceId","sourceUrl","verificationStatus"],"properties":{"indicator":{"$ref":"#/$defs/text"},"value":{"type":["number","string","null"]},"unit":{"$ref":"#/$defs/text"},"geography":{"$ref":"#/$defs/text"},"referenceYear":{"type":"integer","minimum":1},"period":{"$ref":"#/$defs/text"},"sourceId":{"$ref":"#/$defs/text"},"sourceUrl":{"$ref":"#/$defs/url"},"verificationStatus":{"$ref":"#/$defs/text"},"derived":{"const":false},"published":{"const":true}},"anyOf":[{"required":["referenceYear"]},{"required":["period"]}]},
    "municipality": {"type":"object","required":["schemaVersion","recordId","name","province","region","populationFacts","asOf","geography"],"properties":{"schemaVersion":{"const":"civic-municipality/v1"},"recordId":{"$ref":"#/$defs/text"},"name":{"$ref":"#/$defs/text"},"province":{"$ref":"#/$defs/text"},"region":{"$ref":"#/$defs/text"},"asOf":{"$ref":"#/$defs/date"},"populationFacts":{"type":"array","items":{"$ref":"#/$defs/statistic"}},"geography":{"type":"object"}}},
    "barangayClaim": {"type":"object","required":["sourceId","sourceUrl","claim","count","namesAsPublished","verificationStatus"],"properties":{"sourceId":{"$ref":"#/$defs/text"},"sourceUrl":{"$ref":"#/$defs/url"},"claim":{"$ref":"#/$defs/text"},"count":{"type":"integer","minimum":0},"namesAsPublished":{"type":["array","null"],"items":{"$ref":"#/$defs/text"}},"verificationStatus":{"$ref":"#/$defs/text"}}},
    "barangayPopulation": {"type":"object","required":["sourceName","population2015","population2020"],"properties":{"sourceName":{"$ref":"#/$defs/text"},"population2015":{"type":"integer","minimum":0},"population2020":{"type":"integer","minimum":0}}},
    "barangays": {"type":"object","required":["schemaVersion","capturedAt","canonicalRoster","sourceClaims","secondaryPopulationTable","discrepancies"],"properties":{"schemaVersion":{"const":"civic-barangay-roster-evidence/v1"},"capturedAt":{"$ref":"#/$defs/date"},"canonicalRoster":{"type":"object","required":["status","count","sourceId"]},"sourceClaims":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/barangayClaim"}},"secondaryPopulationTable":{"type":"object","required":["sourceId","referenceYears","verificationStatus","rows"],"properties":{"sourceId":{"$ref":"#/$defs/text"},"referenceYears":{"type":"array","items":{"type":"integer"}},"verificationStatus":{"$ref":"#/$defs/text"},"rows":{"type":"array","items":{"$ref":"#/$defs/barangayPopulation"}}}},"discrepancies":{"type":"array"}}},
    "official": {"type":"object","required":["recordId","displayName","directorySection","roleLabel"],"properties":{"recordId":{"$ref":"#/$defs/text"},"displayName":{"$ref":"#/$defs/text"},"directorySection":{"$ref":"#/$defs/text"},"roleLabel":{"type":["string","null"]},"sourceId":{"$ref":"#/$defs/text"},"profileSourceId":{"$ref":"#/$defs/text"}},"anyOf":[{"required":["sourceId","verificationStatus"]},{"required":["profileSourceId","roleEvidence"]}]},
    "officials": {"type":"object","required":["schemaVersion","capturedAt","records"],"properties":{"schemaVersion":{"const":"civic-official-directory-evidence/v1"},"capturedAt":{"$ref":"#/$defs/date"},"records":{"type":"array","items":{"$ref":"#/$defs/official"}}}},
    "contact": {"type":"object","required":["service","category","numbersAsPublished","verificationStatus"],"properties":{"service":{"$ref":"#/$defs/text"},"category":{"$ref":"#/$defs/text"},"numbersAsPublished":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"}},"verificationStatus":{"$ref":"#/$defs/text"}}},
    "emergency-contacts": {"type":"object","required":["schemaVersion","capturedAt","sourceId","sourceUrl","freshnessStatus","records","publicUseWarning"],"properties":{"schemaVersion":{"const":"civic-emergency-contact-evidence/v1"},"capturedAt":{"$ref":"#/$defs/date"},"sourceId":{"$ref":"#/$defs/text"},"sourceUrl":{"$ref":"#/$defs/url"},"freshnessStatus":{"$ref":"#/$defs/text"},"records":{"type":"array","items":{"$ref":"#/$defs/contact"}},"publicUseWarning":{"$ref":"#/$defs/text"}}},
    "service": {
      "type":"object",
      "required":["recordId","sourceId","name","office","description","classification","transactionType","eligibility","requirements","steps","fees","processingTime","sourceDocument","discrepancies"],
      "properties":{
        "recordId":{"$ref":"#/$defs/text"},"sourceId":{"$ref":"#/$defs/text"},"name":{"$ref":"#/$defs/text"},
        "office":{"type":"string"},"description":{"type":"string"},"classification":{"type":"string"},"transactionType":{"type":"string"},"eligibility":{"type":"string"},
        "requirements":{"type":"array","items":{"type":"object","required":["name","source"],"properties":{"name":{"type":"string"},"source":{"type":"string"}}}},
        "steps":{"type":"array","items":{"type":"object","required":["order","client","action","fee","time","responsible"],"properties":{"order":{"type":"integer","minimum":1},"client":{"type":"string"},"action":{"type":"string"},"fee":{"type":"string"},"time":{"type":"string"},"responsible":{"type":"string"}}}},
        "fees":{"type":"string"},"processingTime":{"type":"string"},"sourceDocument":{"$ref":"#/$defs/text"},"discrepancies":{"type":"array","items":{"$ref":"#/$defs/text"}}
      }
    },
    "services": {"type":"object","required":["schemaVersion","capturedAt","sourceId","sourceUrl","observedServiceRows","catalogueStatus","services"],"properties":{"schemaVersion":{"const":"civic-service-catalogue-evidence/v1"},"capturedAt":{"$ref":"#/$defs/date"},"sourceId":{"$ref":"#/$defs/text"},"sourceUrl":{"$ref":"#/$defs/url"},"observedServiceRows":{"type":"integer","minimum":0},"catalogueStatus":{"$ref":"#/$defs/text"},"services":{"type":"array","items":{"$ref":"#/$defs/service"}}}},
    "sector-inventory": {"type":"object","required":["schemaVersion","capturedAt","sectors"],"properties":{"schemaVersion":{"const":"civic-sector-coverage/v1"},"capturedAt":{"$ref":"#/$defs/date"},"sectors":{"type":"array","items":{"type":"object","required":["sector","availability"],"anyOf":[{"required":["missingData"]},{"required":["factsFile"]}],"properties":{"sector":{"$ref":"#/$defs/text"},"availability":{"$ref":"#/$defs/text"},"factsFile":{"$ref":"#/$defs/text"},"missingData":{"type":"array","items":{"$ref":"#/$defs/text"}}}}}}},
    "transparency": {"type":"object","required":["schemaVersion","capturedAt","summary","sourceChecks","officialLocalDocumentLeads","procurementAndProjectCoverage"],"properties":{"schemaVersion":{"const":"civic-transparency-evidence/v1"},"capturedAt":{"$ref":"#/$defs/date"},"summary":{"type":"object","required":["completeMunicipalFinanceDatasetAvailable","completeProcurementDatasetAvailable","completeInfrastructureProjectDatasetAvailable","publishedTotalValues","zeroValuesImplied"]},"sourceChecks":{"type":"array","items":{"type":"object","required":["sourceId","sourceUrl","retrievalStatus","publicationDisposition"],"properties":{"sourceId":{"$ref":"#/$defs/text"},"sourceUrl":{"$ref":"#/$defs/url"},"retrievalStatus":{"$ref":"#/$defs/text"},"publicationDisposition":{"$ref":"#/$defs/text"}}}},"officialLocalDocumentLeads":{"type":"array"},"procurementAndProjectCoverage":{"type":"object"}}},
    "legislationRecord": {"type":"object","required":["recordId","documentType","documentNumber","publicationStatus","title","authorText","committeeText","sourceDateLabel","sourceDate","documentUrl","sourceRecordOrder","sourceId","verificationStatus"],"properties":{"recordId":{"$ref":"#/$defs/text"},"documentType":{"enum":["ordinance","resolution"]},"documentNumber":{"$ref":"#/$defs/text"},"publicationStatus":{"type":["string","null"]},"title":{"$ref":"#/$defs/text"},"authorText":{"type":"string"},"committeeText":{"type":["string","null"]},"sourceDateLabel":{"$ref":"#/$defs/text"},"sourceDate":{"type":"string","format":"date"},"documentUrl":{"$ref":"#/$defs/url"},"sourceRecordOrder":{"type":"integer","minimum":1},"sourceId":{"$ref":"#/$defs/text"},"verificationStatus":{"$ref":"#/$defs/text"}}},
    "sourceResponse": {"type":"object","required":["url","finalUrl","status","contentType","retrievedAt","sourceDate","sha256","rowCount"],"properties":{"url":{"$ref":"#/$defs/url"},"finalUrl":{"$ref":"#/$defs/url"},"status":{"const":200},"contentType":{"$ref":"#/$defs/text"},"retrievedAt":{"$ref":"#/$defs/date"},"sourceDate":{"anyOf":[{"$ref":"#/$defs/date"},{"type":"null"}]},"sha256":{"$ref":"#/$defs/hash"},"rowCount":{"type":"integer","minimum":0}}},
    "legislation": {
      "type":"object",
      "required":["schemaVersion","documentType","municipality","retrievedAt","sourceIndexUrl","sourceFeedUrl","sourceId","sourceFeedSha256","recordsTotal","recordsFiltered","recordCount","recordScope","records"],
      "properties":{
        "schemaVersion":{"const":"civic-legislation-record-set/v1"},"documentType":{"enum":["ordinance","resolution"]},
        "retrievedAt":{"$ref":"#/$defs/date"},"sourceIndexUrl":{"$ref":"#/$defs/url"},"sourceFeedUrl":{"$ref":"#/$defs/url"},
        "sourceId":{"$ref":"#/$defs/text"},"sourceFeedSha256":{"$ref":"#/$defs/hash"},
        "sourceResponses":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/sourceResponse"}},
        "sourceHashScope":{"enum":["SHA-256 of exact source-response bytes","SHA-256 of JSON array of ordered page-response SHA-256 strings; each exact response-byte hash retained in sourceResponses"]},
        "recordsTotal":{"type":"integer","minimum":0},"recordsFiltered":{"type":"integer","minimum":0},
        "recordCount":{"type":"integer","minimum":0},"recordScope":{"$ref":"#/$defs/text"},
        "records":{"type":"array","items":{"$ref":"#/$defs/legislationRecord"}}
      },
      "dependencies":{"sourceResponses":["sourceHashScope"],"sourceHashScope":["sourceResponses"]}
    },
    "dataset-manifest": {"type":"object","required":["schemaVersion","municipality","generatedAt","license","datasets","globalLimitations"],"properties":{"schemaVersion":{"const":"civic-data-manifest/v1"},"generatedAt":{"$ref":"#/$defs/date"},"municipality":{"type":"object","required":["recordId","name","province"]},"license":{"type":"object","required":["upstreamContent"]},"datasets":{"type":"array","minItems":1,"items":{"type":"object","required":["id","canonicalJson","schemaVersion","recordCount","status"],"properties":{"id":{"$ref":"#/$defs/text"},"canonicalJson":{"$ref":"#/$defs/text"},"schemaVersion":{"$ref":"#/$defs/text"},"recordCount":{"type":"integer","minimum":0},"status":{"$ref":"#/$defs/text"}}}},"globalLimitations":{"type":"array"}}},
    "evidence": {"type":"object","required":["sourceId","sourceUrl","retrievedAt","verificationNote","verificationStatus","availabilityStatus","freshnessStatus"],"properties":{"sourceId":{"$ref":"#/$defs/text"},"sourceUrl":{"$ref":"#/$defs/url"},"retrievedAt":{"$ref":"#/$defs/date"},"verificationNote":{"$ref":"#/$defs/text"},"contentHash":{"$ref":"#/$defs/hash"},"verificationStatus":{"enum":["primary-direct","primary-index-only","secondary-only","machine-extracted-unreviewed","conflicted","not-reviewed"]},"availabilityStatus":{"enum":["available","access-blocked","not-published","empty-in-capture","not-found-in-checked-source","unknown"]},"freshnessStatus":{"enum":["current-at-capture","stale","not-checked","not-applicable"]}}}
  }
}
